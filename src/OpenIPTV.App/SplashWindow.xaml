<Window x:Class="OpenIPTV.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenIPTV"
        Icon="pack://application:,,,/Assets/openiptv.ico"
        Width="520" Height="320"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True">

    <!-- Fixed dark card with the orange brand colour, independent of the Windows light/dark theme. -->
    <Border CornerRadius="14" Margin="12" BorderThickness="0,4,0,0" BorderBrush="#F97316">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1F2937" Offset="0" />
                <GradientStop Color="#111827" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid Margin="32,26,32,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/openiptv.png" Width="88" Height="88" Margin="0,0,22,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OpenIPTV" FontSize="36" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Free IPTV for Windows" FontSize="15" Foreground="#F97316" Margin="2,0,0,0" />
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="#9CA3AF" Margin="2,4,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="StatusText" Text="Starting …" Foreground="#E5E7EB" FontSize="13"
                       Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />

            <ProgressBar Grid.Row="2" x:Name="Progress" Height="4" Minimum="0" Maximum="100" Value="5"
                         Foreground="#F97316" Background="#374151" BorderThickness="0" />

            <TextBlock Grid.Row="3" Text="Channel lists from the iptv-org project · playback by VLC" FontSize="11"
                       Foreground="#6B7280" Margin="0,10,0,0" />
        </Grid>
    </Border>
</Window>
