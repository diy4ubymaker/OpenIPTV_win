<Application x:Class="OpenIPTV.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenIPTV.App"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#F97316" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#C2410C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#808891" />
        <!-- Pop-up panel background; swapped by WpfUiServices.ApplyTheme for light/dark. -->
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />

        <!-- Orange call-to-action buttons. -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Top navigation as toggle-like radio buttons. -->
        <Style x:Key="NavButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="90" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,4,12,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
