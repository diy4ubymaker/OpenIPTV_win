<Window x:Class="OpenIPTV.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenIPTV.App"
        xmlns:vm="clr-namespace:OpenIPTV.ViewModels;assembly=OpenIPTV.ViewModels"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="{Binding Title}"
        Icon="pack://application:,,,/Assets/openiptv.ico"
        Width="1440" Height="900" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F11" Command="{Binding ToggleFullscreenCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitFullscreenCommand}" />
        <KeyBinding Key="F5" Command="{Binding SyncNowCommand}" />
        <KeyBinding Key="PageDown" Modifiers="Control" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="PageUp" Modifiers="Control" Command="{Binding PrevPageCommand}" />
        <KeyBinding Key="Space" Modifiers="Control" Command="{Binding PauseCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Multi-select filter: a toggle button that opens a popup with a search box and check boxes. -->
        <DataTemplate x:Key="FilterTemplate" DataType="{x:Type vm:FilterViewModel}">
            <Grid Margin="0,0,8,0">
                <ToggleButton x:Name="FilterToggle" MinWidth="150" MaxWidth="260" Padding="10,5"
                              HorizontalContentAlignment="Left" ToolTip="{Binding Summary}">
                    <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=FilterToggle, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=FilterToggle}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8" Width="300">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Clear" Margin="6,0,0,0" Padding="10,3"
                                        Command="{Binding ClearCommand}" />
                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Type to filter the list" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Visible}" MaxHeight="380"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FilterOption}">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Display}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border x:Name="HeaderBar" Grid.Row="0" Padding="14,8" BorderThickness="0,0,0,3"
                BorderBrush="{StaticResource AccentBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/openiptv.png" Width="30" Height="30" Margin="0,0,10,0" />
                    <TextBlock Text="OpenIPTV" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    <!-- Version badge (number comes from Directory.Build.props). -->
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="9" Padding="8,1" Margin="8,2,18,0"
                            VerticalAlignment="Center" ToolTip="{Binding Title}">
                        <TextBlock Text="{Binding Version, StringFormat=v{0}}" Foreground="White" FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                    <RadioButton x:Name="NavChannels" Style="{StaticResource NavButton}" Content="Channels"
                                 GroupName="Nav" IsChecked="True" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavSources" Style="{StaticResource NavButton}" Content="Sources"
                                 GroupName="Nav" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Settings"
                                 GroupName="Nav" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Content="Sync history"
                                 GroupName="Nav" Checked="OnNavChecked" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SyncText}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding NextRunText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="⟳  Sync now" Style="{StaticResource AccentButton}" Padding="16,6"
                            Command="{Binding SyncNowCommand}" ToolTip="Pull all sources and test streams now (F5)" />
                </StackPanel>
                <TextBlock Text="{Binding TotalsText}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
            </DockPanel>
        </Border>

        <!-- Channels page -->
        <Grid x:Name="ChannelsPage" Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="3*" MinWidth="0" />
                <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                <ColumnDefinition Width="2*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- left: filters + list -->
            <DockPanel x:Name="LeftPane" Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Search" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" />
                        <Button DockPanel.Dock="Right" Content="Clear filters" Margin="8,0,0,0" Padding="12,4"
                                Command="{Binding ClearFiltersCommand}" />
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Channel name (also matches alternative names and IDs)" />
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource FilterTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="120" ItemsSource="{x:Static vm:MainViewModel.StatusFilters}"
                                  SelectedItem="{Binding StatusFilter}" Margin="0,0,16,0" />
                        <TextBlock Text="Sort by" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="120" ItemsSource="{x:Static vm:MainViewModel.SortOptions}"
                                  SelectedItem="{Binding Sort1}" Margin="0,0,6,0" />
                        <TextBlock Text="then" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="120" ItemsSource="{x:Static vm:MainViewModel.SortOptions2}"
                                  SelectedItem="{Binding Sort2}" Margin="0,0,10,0" ToolTip="Second sort key (blank = none)" />
                        <CheckBox Content="Descending" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <DockPanel Margin="0,2,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Export M3U" Padding="10,3" Margin="6,0,0,0" Command="{Binding ExportM3uCommand}"
                                    ToolTip="Save the channels shown as an M3U playlist (VLC, Kodi, TiviMate …)" />
                            <Button Content="Export CSV" Padding="10,3" Margin="6,0,0,0" Command="{Binding ExportCsvCommand}"
                                    ToolTip="Save the channels shown (one row per stream) for Excel" />
                        </StackPanel>
                        <TextBlock Text="{Binding CountsText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>

                <!-- pager -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="⏮" Padding="10,3" Margin="0,0,4,0" Command="{Binding FirstPageCommand}" ToolTip="First page" />
                        <Button Content="◀" Padding="10,3" Margin="0,0,10,0" Command="{Binding PrevPageCommand}"
                                ToolTip="Previous page (Ctrl+Page Up)" />
                        <TextBlock Text="Page" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                        <TextBox x:Name="PageBox" Width="64" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                 Text="{Binding CurrentPage}" KeyDown="OnPageBoxKeyDown"
                                 ToolTip="Type a page number and press Enter" />
                        <TextBlock Text="{Binding PageText}" Style="{StaticResource FieldLabel}" Margin="6,0,10,0" />
                        <Button Content="▶" Padding="10,3" Margin="0,0,4,0" Command="{Binding NextPageCommand}"
                                ToolTip="Next page (Ctrl+Page Down)" />
                        <Button Content="⏭" Padding="10,3" Command="{Binding LastPageCommand}" ToolTip="Last page" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Per page" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="86" ItemsSource="{x:Static vm:MainViewModel.PageSizes}" SelectedItem="{Binding PageSize}"
                                  ToolTip="Channels shown per page (remembered)" />
                    </StackPanel>
                </DockPanel>

                <DataGrid x:Name="ChannelGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserSortColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          MouseDoubleClick="OnGridDoubleClick" PreviewKeyDown="OnGridKeyDown" Sorting="OnGridSorting">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="64" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="pack://application:,,,/Assets/channel-placeholder.png" local:LogoImage.Url="{Binding LogoUrl}" local:LogoImage.DecodeHeight="28"
                                           Height="28" MaxWidth="56" Stretch="Uniform" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Categories}" SortMemberPath="Category" Width="1.3*" />
                        <DataGridTextColumn Header="Language" Binding="{Binding Languages}" SortMemberPath="Language" Width="1.3*" />
                        <DataGridTextColumn Header="Country" Binding="{Binding Country}" SortMemberPath="Country" Width="1.2*" />
                        <DataGridTextColumn Header="Code" Binding="{Binding CountryCode}" SortMemberPath="Code" Width="52" />
                        <DataGridTextColumn Header="Src" Binding="{Binding StreamCount}" SortMemberPath="Sources" Width="44" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" SortMemberPath="Status" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent" />

            <!-- right: player + details -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="220" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="DetailsRow" Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Black" CornerRadius="6">
                    <vlc:VideoView x:Name="Video" Background="Black">
                        <!-- Overlay (rendered above the native video window): messages + double-click for full screen. -->
                        <Grid x:Name="VideoOverlay" Background="#01000000" MouseLeftButtonDown="OnVideoMouseDown">
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14,8"
                                    CornerRadius="6" Background="#B0000000"
                                    Visibility="{Binding PlayerMessage, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="{Binding PlayerMessage}" Foreground="White" TextWrapping="Wrap"
                                           MaxWidth="420" TextAlignment="Center" />
                            </Border>
                        </Grid>
                    </vlc:VideoView>
                </Border>

                <!-- player controls -->
                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="▶  Play" Style="{StaticResource AccentButton}" Padding="16,5" Margin="0,0,6,0"
                                Command="{Binding PlayCommand}" ToolTip="Play the selected source (Enter / double-click)" />
                        <Button Content="⏯" Padding="10,5" Margin="0,0,6,0" Command="{Binding PauseCommand}" ToolTip="Pause / resume (Ctrl+Space)" />
                        <Button Content="⏹" Padding="10,5" Margin="0,0,6,0" Command="{Binding StopCommand}" ToolTip="Stop" />
                        <Button Content="⛶" Padding="10,5" Margin="0,0,12,0" Command="{Binding ToggleFullscreenCommand}"
                                ToolTip="Full screen (F11, double-click video; Esc to exit)" />
                        <Button Padding="8,5" Margin="0,0,4,0" Command="{Binding ToggleMuteCommand}" ToolTip="{Binding MuteToolTip}">
                            <Button.Style>
                                <!-- Orange and crossed-out speaker while muted. -->
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="🔊" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Content" Value="🔇" />
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Slider Width="110" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center"
                                ToolTip="Volume" />
                    </StackPanel>
                    <TextBlock Text="{Binding NowPlaying}" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- channel details -->
                <Border x:Name="DetailsPane" Grid.Row="2" Margin="0,10,0,0" Padding="12" CornerRadius="6"
                        BorderThickness="1" BorderBrush="{StaticResource MutedBrush}">
                    <Grid>
                        <TextBlock Text="Select a channel in the list. Double-click or press Enter to play it."
                                   Style="{StaticResource Muted}"
                                   Visibility="{Binding Channel, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                        <StackPanel Visibility="{Binding Channel, Converter={StaticResource NullToVisibility}}">
                            <DockPanel Margin="0,0,0,8">
                                <Border DockPanel.Dock="Left" Width="96" Height="56" Margin="0,0,12,0" CornerRadius="4"
                                        Background="#20808080">
                                    <Image Source="pack://application:,,,/Assets/channel-placeholder.png" local:LogoImage.Url="{Binding Channel.LogoUrl}" local:LogoImage.DecodeHeight="56"
                                           Stretch="Uniform" Margin="4" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Channel.Name}" FontSize="18" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Channel.Id}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Category" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Channel.Categories}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Language" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Channel.Languages}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Country" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                    <Run Text="{Binding Channel.Country, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding Channel.CountryCode, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Status" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                                    <Run Text="{Binding ChannelStatusText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ChannelLastChecked, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Website" Style="{StaticResource FieldLabel}"
                                           Visibility="{Binding Channel.Website, Converter={StaticResource NotEmptyToVisibility}}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                                           Visibility="{Binding Channel.Website, Converter={StaticResource NotEmptyToVisibility}}">
                                    <Hyperlink Command="{Binding OpenWebsiteCommand}">
                                        <Run Text="{Binding Channel.Website, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="Source" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Streams}" SelectedItem="{Binding SelectedStream}"
                                      DisplayMemberPath="Display" Margin="0,0,0,8" />

                            <TextBlock Text="Source URL" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Copy" Padding="12,4" Margin="6,0,0,0"
                                        Command="{Binding CopyUrlCommand}" ToolTip="Copy the original stream URL (for VLC or other players)" />
                                <TextBox Text="{Binding SourceUrl, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding SourceNotes}" Style="{StaticResource Muted}" Margin="0,0,0,8"
                                       Visibility="{Binding SourceNotes, Converter={StaticResource NotEmptyToVisibility}}" />

                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="⟳  Check source now" Padding="12,5"
                                        Command="{Binding RecheckCommand}"
                                        ToolTip="Test all sources of this channel now and update their status" />
                                <TextBlock Text="{Binding ChannelMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Sources page -->
        <DockPanel x:Name="SourcesPage" Grid.Row="1" Margin="14" Visibility="Collapsed" DataContext="{Binding Sources}">
            <TextBlock DockPanel.Dock="Top" Text="Channel sources" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Help}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Add" Padding="14,5" Margin="0,0,6,0" Command="{Binding AddCommand}" />
                <Button Content="Remove" Padding="14,5" Margin="0,0,6,0" Command="{Binding RemoveCommand}" />
                <Button Content="Restore defaults" Padding="14,5" Margin="0,0,18,0" Command="{Binding DefaultsCommand}" />
                <Button Content="Revert" Padding="14,5" Margin="0,0,6,0" Command="{Binding RevertCommand}" />
                <Button x:Name="SaveSourcesButton" Content="Save" Style="{StaticResource AccentButton}" Padding="18,5"
                        Click="OnSaveSources" />
                <TextBlock Text="  ● unsaved changes" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <DataGrid x:Name="SourcesGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="44" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" />
                    <DataGridComboBoxColumn Header="Kind" Width="130"
                                            ItemsSource="{x:Static vm:SourcesViewModel.Kinds}"
                                            SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="URL" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Width="2.6*" />
                    <DataGridTextColumn Header="Options (key=value; …)" Binding="{Binding Options, UpdateSourceTrigger=PropertyChanged}" Width="1.6*" />
                    <DataGridTextColumn Header="Last run" Binding="{Binding LastRunText, Mode=OneWay}" IsReadOnly="True" Width="120" />
                    <DataGridTextColumn Header="Last status" Binding="{Binding LastStatus, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Settings page -->
        <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                      DataContext="{Binding SettingsPage}">
            <StackPanel Margin="14" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

                <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" Width="320" />
                    <ComboBox Width="160" ItemsSource="{x:Static vm:SettingsViewModel.Themes}"
                              SelectedItem="{Binding Theme}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                           Text="Applied immediately. System follows the Windows light/dark setting." />

                <TextBlock Text="Sync and stream checks" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sync every (minutes)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,3"
                             Text="{Binding SyncIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,3" Content="Sync when the app starts"
                              IsChecked="{Binding SyncOnStartup}" />
                    <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,3" Content="Test streams during each sync"
                              IsChecked="{Binding CheckStreamsOnSync}" />

                    <TextBlock Grid.Row="3" Text="Concurrent stream checks" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,3"
                             Text="{Binding CheckConcurrency, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Text="Check timeout (seconds)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,3"
                             Text="{Binding CheckTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Text="Max stream checks per sync (0 = all)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,3"
                             Text="{Binding MaxChecksPerCycle, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="6" Text="'Check source now' cooldown (seconds)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,3"
                             Text="{Binding RecheckCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="7" Text="Player network caching (ms)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="7" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,3"
                             Text="{Binding PlayerNetworkCachingMs, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Higher = smoother on slow networks, lower = faster start" />

                    <CheckBox Grid.Row="8" Grid.Column="1" Margin="0,3" Content="Verify TLS certificates"
                              IsChecked="{Binding VerifyTls}" />
                    <CheckBox Grid.Row="9" Grid.Column="1" Margin="0,3" Content="Include adult (NSFW) channels"
                              IsChecked="{Binding IncludeNsfw}" />
                    <CheckBox Grid.Row="10" Grid.Column="1" Margin="0,3" Content="Keep channels that have no streams"
                              IsChecked="{Binding KeepChannelsWithoutStreams}" />

                    <TextBlock Grid.Row="11" Text="GitHub token (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="11" Grid.Column="1" Margin="0,3" Text="{Binding GithubToken, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Only needed if you sync the repository source very often (GitHub allows 60 requests/hour without it)" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Revert" Padding="14,5" Margin="0,0,6,0" Command="{Binding RevertCommand}" />
                    <Button Content="Save" Style="{StaticResource AccentButton}" Padding="18,5" Command="{Binding SaveCommand}" />
                </StackPanel>

                <TextBlock Text="Data folder" FontWeight="SemiBold" Margin="0,24,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open" Padding="12,4" Margin="6,0,0,0"
                            Command="{Binding DataContext.OpenDataFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                           Text="Channels, sources, settings, history and the log are stored here. To run portable (e.g. from a USB stick), create a folder named 'data' next to OpenIPTV.exe. The OPENIPTV_DATA_DIR environment variable overrides both." />

                <TextBlock Text="About" FontWeight="SemiBold" Margin="0,24,0,4" />
                <TextBlock Margin="0,0,0,4" FontSize="14">
                    <Run Text="Version" />
                    <Run Text="{Binding DataContext.Version, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                         FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Muted}">
                    <Run Text="{Binding DataContext.Title, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Run Text=" — free for all. Channel lists from the iptv-org project (github.com/iptv-org); playback by VLC (LibVLC). OpenIPTV only lists publicly published links and stores no video." />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- History page -->
        <Grid x:Name="HistoryPage" Grid.Row="1" Margin="14" Visibility="Collapsed" DataContext="{Binding History}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Clear history" Padding="12,4" Command="{Binding ClearHistoryCommand}"
                        ToolTip="Delete all sync history entries" />
                <TextBlock Text="Sync history" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Runs}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="150" />
                    <DataGridTextColumn Header="Finished" Binding="{Binding Finished}" Width="80" />
                    <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="90" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                    <DataGridTextColumn Header="Channels" Binding="{Binding Channels}" Width="80" />
                    <DataGridTextColumn Header="Streams" Binding="{Binding Streams}" Width="80" />
                    <DataGridTextColumn Header="Checked" Binding="{Binding Checked}" Width="150" />
                    <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="2" Margin="0,12,0,6">
                <Button DockPanel.Dock="Right" Content="Clear log" Padding="12,4" Margin="6,0,0,0" Command="{Binding ClearLogCommand}"
                        ToolTip="Clear the live log and empty openiptv.log" />
                <Button DockPanel.Dock="Right" Content="Open log file" Padding="12,4" Command="{Binding OpenLogCommand}" />
                <TextBlock Text="Live log" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox Grid.Row="3" x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas"
                     VirtualizingPanel.IsVirtualizing="True" />
        </Grid>
    </Grid>
</Window>
