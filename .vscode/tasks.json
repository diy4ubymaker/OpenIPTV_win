{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/OpenIPTV.sln", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/tests/OpenIPTV.Tests"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "test (live iptv-org sync)",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/tests/OpenIPTV.Tests", "--", "--live"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish single-file exe",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "problemMatcher": "$msCompile"
    }
  ]
}
